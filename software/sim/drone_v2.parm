# Параметры SITL под наш дрон (поверх Tools/autotest/default_params/copter.parm)
FRAME_CLASS     1        # квадрокоптер
FRAME_TYPE      1        # X
ARMING_CHECK    0        # в симуляторе не ждём калибровок
GPS1_TYPE       1
SIM_GPS1_NUMSATS 12
# масса/тяга: SITL использует нормированную модель; ближе к реальности через SIM_*
SIM_WIND_SPD    0
# GUIDED: разрешить скоростные команды без позиции
GUID_OPTIONS    0
WPNAV_SPEED     300      # см/с
WPNAV_SPEED_DN  100
LAND_SPEED      40       # см/с на последних метрах
PILOT_TKOFF_ALT 400
# precision landing (для варианта через LANDING_TARGET)
PLND_ENABLED    1
PLND_TYPE       1        # companion computer
PLND_EST_TYPE   0
# логирование в SITL не нужно
LOG_DISARMED    0
